# =============================================================================
# Criticalis — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Required values are marked with [REQUIRED].
# =============================================================================

# -- Domain & URL -------------------------------------------------------------
# The domain or subdomain where Criticalis will be served.
# Examples: criticalis.example.com, treasury.mysite.org, localhost
DOMAIN=localhost

# The full public URL (protocol + domain). Used for auth callbacks and CORS.
# For production, use https://your-domain.com
PUBLIC_URL=http://localhost

# Port the proxy listens on (host side). Default: 80
LISTEN_PORT=80

# -- Database -----------------------------------------------------------------
# PostgreSQL credentials. These are used by both the app and the db container.
POSTGRES_USER=criticalis
POSTGRES_PASSWORD=          # [REQUIRED] Set a strong password
POSTGRES_DB=criticalis

# For local development (without Docker), set the full connection string:
# DATABASE_URL=postgresql://criticalis:password@localhost:5432/criticalis

# -- Auth ---------------------------------------------------------------------
# Secret key for signing auth tokens. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=         # [REQUIRED] Generate a secret key

# -- Optional: OAuth Providers ------------------------------------------------
# Uncomment and fill in to enable social login.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# -- Storage ------------------------------------------------------------------
# Path to ePub source files. In Docker, this is mounted at /data/sources.
# For local dev, defaults to ./sources relative to the project root.
# SOURCES_PATH=./sources
